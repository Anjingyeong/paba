{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["assets/ts"],
  "exclude": ["node_modules", "assets/vendor"]
}
