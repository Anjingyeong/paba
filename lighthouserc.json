{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/templates/kiosk/states.html",
        "http://localhost/templates/manager/console.html",
        "http://localhost/templates/design-system/showcase.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
