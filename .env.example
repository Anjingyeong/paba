# Copy to .env for local development. NEVER commit a real .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-real-environments
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
EMPLOYEE_MASTER_PIN=246810

# PostgreSQL (native local install or Docker). The app requires real PostgreSQL.
POSTGRES_DB=paris_baguette
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
